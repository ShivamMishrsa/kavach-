# Copy to .env (never commit .env)
KAVACH_ENV=dev
KAVACH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OCR. Leave both empty when Tesseract is on PATH and has the eng + hin language files.
# Windows (installed with: winget install UB-Mannheim.TesseractOCR):
# KAVACH_TESSERACT_CMD=C:/Users/<you>/AppData/Local/Programs/Tesseract-OCR/tesseract.exe
# Folder holding eng.traineddata and hin.traineddata (see README):
# KAVACH_TESSDATA_DIR=tessdata

# Where feedback and consent records are appended (one JSON line each, never a file or a result).
# KAVACH_DATA_DIR=data

# Signs PDF download links and hashes IP addresses in the consent log. Set a long random value
# in production (python -c "import secrets; print(secrets.token_hex(32))"); if it is empty a new
# one is made at every start, so links and IP hashes stop matching after a restart.
# KAVACH_SECRET=

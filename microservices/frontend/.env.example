# Copy to .env.local (never commit it).
# Address of the backend (see microservices/backend). Leave it unset to use the in-browser demo
# mock, where every result is simulated.
VITE_API_URL=http://localhost:8000
# Public address of the site, for example https://kavach.example (no trailing path). Needed to write
# sitemap.xml at build time.
# VITE_SITE_URL=
# Set to true when building to show only the maintenance page.
# VITE_MAINTENANCE=false
